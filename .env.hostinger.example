# STEP Platform - Hostinger Demo Environment Template
# ================================================
# CRITICAL: Replace ALL placeholder values with actual Hostinger credentials
# NEVER commit this file with real secrets to version control
# Deploy ONLY after rotating all credentials from local development

# ============================================================================
# APPLICATION CORE
# ============================================================================
APP_NAME="STEP Platform Demo"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_APP_KEY_HERE_GENERATE_WITH_php_artisan_key_generate
APP_URL=https://your-hostinger-domain.com

# ============================================================================
# DATABASE - Hostinger MySQL/MariaDB
# ============================================================================
DB_CONNECTION=mysql
DB_HOST=your-hostinger-database-host.com
DB_PORT=3306
DB_DATABASE=demo_step_db
DB_USERNAME=demo_step_user
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

# ============================================================================
# SESSION & AUTHENTICATION
# ============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================================================
# CACHE & QUEUE - For OTP expiration and background tasks
# ============================================================================
CACHE_STORE=database
QUEUE_CONNECTION=database

# ============================================================================
# FILE STORAGE - Configure based on your document privacy requirements
# ============================================================================
FILESYSTEM_DISK=local
# For public proof documents on Hostinger (NOT RECOMMENDED for production):
# FILESYSTEM_DISK=public
# For private documents with authorized download, keep as 'local'

# ============================================================================
# LOGGING - IMPORTANT: Sanitize before going live
# ============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Set to 'warning' or 'error' in production to avoid logging sensitive OTP/token data

# ============================================================================
# MAIL - SMTP Configuration for Hostinger
# ============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your-email@your-domain.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD_OR_APP_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="STEP Platform"

# ============================================================================
# BROADCAST & NOTIFICATION
# ============================================================================
BROADCAST_CONNECTION=log

# ============================================================================
# SUPER ADMIN SEEDER - Configure for initial admin account
# ============================================================================
SEED_SUPERADMIN_EMAIL=superadmin@your-domain.com
SEED_SUPERADMIN_NAME="STEP Super Admin"
SEED_SUPERADMIN_PASSWORD=YOUR_STRONG_SUPERADMIN_PASSWORD_HERE

# ============================================================================
# SUPABASE CONFIGURATION - For file storage & backend services
# ============================================================================
VITE_SUPABASE_URL=https://your-supabase-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key for backend requests (from Supabase Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase S3 Storage for Proof Documents
SUPABASE_S3_KEY=your_s3_key_here
SUPABASE_S3_SECRET=your_s3_secret_here
SUPABASE_S3_ENDPOINT=https://your-supabase-project-url.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=ledger-proofs

# ============================================================================
# AWS S3 (Alternative to Supabase S3)
# ============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=

# ============================================================================
# GOOGLE OAUTH (Optional - if using Google login)
# ============================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-hostinger-domain.com/callback

# ============================================================================
# SECURITY & HASHING
# ============================================================================
BCRYPT_ROUNDS=12

# ============================================================================
# MAINTENANCE
# ============================================================================
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ============================================================================
# LOCALIZATION
# ============================================================================
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ============================================================================
# FRONTEND (Vite/React)
# ============================================================================
VITE_APP_NAME="${APP_NAME}"
